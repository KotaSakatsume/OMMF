generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  deviceId    String   @unique
  displayName String   @default("Anonymous Lifter")
  level       Int      @default(1)
  exp         Int      @default(0)
  totalSpots  Int      @default(0)
  title       String   @default("Novice Spotter")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model MatchLog {
  id          String    @id @default(uuid())
  requesterId String
  helperId    String?
  exercise    String
  weight      Float
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([requesterId])
  @@index([helperId])
  @@index([status])
  @@map("match_logs")
}
